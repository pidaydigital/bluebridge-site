---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import CTA from '../components/sections/CTA.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Card from '../components/ui/Card.astro';

const page = (await getEntry('pages', 'home'))!.data;
const sectors = (await getCollection('sectors')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout description={page.description}>
  {page.hero && <Hero {...page.hero} />}

  {
    page.sectorsSection && (
      <section id="what-we-do" class="section" aria-labelledby="what-we-do-heading">
        <div class="container-site">
          <SectionHeading {...page.sectorsSection} id="what-we-do-heading" />
          <ul class="mt-12 grid gap-6 md:grid-cols-3" role="list">
            {sectors.map((sector) => (
              <li>
                <Card eyebrow={sector.data.title} title={sector.data.summary} body={sector.body?.trim()} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {page.cta && <CTA {...page.cta} id="contact" />}
</BaseLayout>
