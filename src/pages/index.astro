---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const home = await getEntry('settings', 'home');
if (!home) throw new Error('Missing "home" entry in src/content/settings.yaml');
const { headline, intro, description } = home.data;
---

<BaseLayout description={description}>
  <main class="mx-auto flex min-h-screen max-w-3xl flex-col justify-center px-6 py-24">
    <h1 class="text-4xl font-bold tracking-tight text-brand-900 sm:text-5xl">{headline}</h1>
    {intro && <p class="mt-6 text-lg text-slate-600">{intro}</p>}
  </main>
</BaseLayout>
