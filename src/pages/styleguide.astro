---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
import Card from '../components/ui/Card.astro';
import Stat from '../components/ui/Stat.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Hero from '../components/sections/Hero.astro';
import StatBand from '../components/sections/StatBand.astro';
import ProjectGrid from '../components/sections/ProjectGrid.astro';
import ProcessSteps from '../components/sections/ProcessSteps.astro';
import CTA from '../components/sections/CTA.astro';
import FAQ from '../components/sections/FAQ.astro';
import KeyFacts from '../components/sections/KeyFacts.astro';
import ProjectOverview from '../components/sections/ProjectOverview.astro';
import BuildingAvailability from '../components/sections/BuildingAvailability.astro';
import LocationAccess from '../components/sections/LocationAccess.astro';
import Gallery from '../components/sections/Gallery.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import FactList from '../components/ui/FactList.astro';
import { buildingStatus, getProjectLabels, getSortedProjects, paragraphs } from '../lib/projects';
import logoBlue from '../assets/images/brand/logo-blue.svg';
import logoWhite from '../assets/images/brand/logo-white.svg';
import industrial from '../assets/images/placeholders/industrial.jpg';

const page = (await getEntry('pages', 'styleguide'))!.data;
const s = page.samples!;
const site = (await getEntry('settings', 'site'))!.data;

// Project components are shown with the first project's content (src/content/projects).
const project = (await getSortedProjects())[0];
const pl = await getProjectLabels();
const pd = project?.data;
const pBuildings = pd ? pd.buildings.map((b) => ({ ...b, status: buildingStatus(b.status, pl) })) : [];

// Static class map so Tailwind can see every class used for the type samples.
const typeClass = {
  display: 'text-display font-display font-bold text-navy-900',
  h1: 'text-h1 font-display font-bold text-navy-900',
  h2: 'text-h2 font-display font-bold text-navy-900',
  h3: 'text-h3 font-display font-bold text-navy-900',
  h4: 'text-h4 font-display font-bold text-navy-900',
  lead: 'text-lead text-steel-700',
  body: 'text-body text-ink',
  small: 'text-small text-muted',
  eyebrow: 'eyebrow text-blue-600',
} as const;

const toc = [
  ['colors', s.sections.colors],
  ['type', s.sections.type],
  ['logo', s.sections.logo],
  ['buttons', s.sections.buttons],
  ['badges', s.sections.badges],
  ['cards', s.sections.cards],
  ['stats', s.sections.stats],
  ['sections', s.sections.sectionsHeading],
];

const label = 'mb-3 font-mono text-[0.75rem] text-steel-500';
---

<BaseLayout title={page.title} description={page.description} noindex={page.noindex}>
  <div class="border-b border-line bg-surface-alt">
    <div class="container-site py-12 md:py-16">
      <p class="eyebrow text-blue-600">{site.siteName}</p>
      <h1 class="mt-3 text-h1 text-navy-900">{page.title}</h1>
      <p class="mt-4 max-w-2xl text-lead text-muted">{s.intro}</p>
      <nav aria-label="Styleguide sections" class="mt-8">
        <ul class="flex flex-wrap gap-2" role="list">
          {
            toc.map(([id, name]) => (
              <li>
                <a
                  href={`#${id}`}
                  class="inline-block rounded-md border border-line bg-white px-3 py-1.5 text-small font-semibold text-navy-700 hover:border-blue-600 hover:text-blue-600"
                >
                  {name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

  <div class="container-site divide-y divide-line">
    <!-- Colour -->
    <section id="colors" class="py-14">
      <SectionHeading heading={s.sections.colors} />
      <ul class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5" role="list">
        {
          s.colors.map((c) => (
            <li class="overflow-hidden rounded-lg border border-line">
              <div class="h-20" style={`background: var(--color-${c.token})`} />
              <div class="p-3">
                <p class="text-small font-semibold text-navy-900">{c.name}</p>
                <p class="font-mono text-[0.75rem] text-steel-500">{c.token}</p>
                <p class="mt-1 text-[0.8125rem] text-muted">{c.note}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Type -->
    <section id="type" class="py-14">
      <SectionHeading heading={s.sections.type} />
      <div class="mt-8 divide-y divide-line">
        {
          s.type.map((t) => (
            <div class="grid gap-2 py-6 md:grid-cols-[12rem_1fr] md:gap-8">
              <div>
                <p class="font-mono text-small text-navy-700">text-{t.token}</p>
                <p class="text-[0.8125rem] text-muted">{t.note}</p>
              </div>
              <p class={typeClass[t.token]}>{t.sample}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Logo -->
    <section id="logo" class="py-14">
      <SectionHeading heading={s.sections.logo} />
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <div class="flex items-center justify-center rounded-lg border border-line bg-white p-10">
          <Image src={logoBlue} alt={site.logoAlt} width={273} height={120} class="h-20 w-auto" />
        </div>
        <div class="flex items-center justify-center rounded-lg bg-navy-900 p-10">
          <Image src={logoWhite} alt={site.logoAlt} width={256} height={113} class="h-20 w-auto" />
        </div>
      </div>
    </section>

    <!-- Buttons -->
    <section id="buttons" class="py-14">
      <SectionHeading heading={s.sections.buttons} />
      <div class="mt-8 space-y-8">
        <div>
          <p class={label}>variant: primary · secondary · ghost</p>
          <div class="flex flex-wrap items-center gap-4">
            <Button href="#buttons" arrow>{s.buttons.primary}</Button>
            <Button href="#buttons" variant="secondary">{s.buttons.secondary}</Button>
            <Button href="#buttons" variant="ghost" arrow>{s.buttons.ghost}</Button>
            <Button type="submit">{s.buttons.submit}</Button>
          </div>
        </div>
        <div>
          <p class={label}>size: sm · md · lg</p>
          <div class="flex flex-wrap items-center gap-4">
            <Button href="#buttons" size="sm">{s.buttons.small}</Button>
            <Button href="#buttons">{s.buttons.primary}</Button>
            <Button href="#buttons" size="lg" arrow>{s.buttons.large}</Button>
          </div>
        </div>
        <div class="rounded-lg bg-navy-900 p-8">
          <p class="mb-3 font-mono text-[0.75rem] text-navy-200">variant: inverse · outline-inverse</p>
          <div class="flex flex-wrap items-center gap-4">
            <Button href="#buttons" variant="inverse" arrow>{s.buttons.inverse}</Button>
            <Button href="#buttons" variant="outline-inverse">{s.buttons.outlineInverse}</Button>
          </div>
        </div>
      </div>
    </section>

    <!-- Badges -->
    <section id="badges" class="py-14">
      <SectionHeading heading={s.sections.badges} />
      <div class="mt-8 flex flex-wrap items-center gap-3">
        {
          s.badges
            .filter((b) => b.tone !== 'inverse')
            .map((b) => <Badge tone={b.tone}>{b.label}</Badge>)
        }
        <span class="inline-flex rounded-md bg-navy-900 p-3">
          {
            s.badges
              .filter((b) => b.tone === 'inverse')
              .map((b) => <Badge tone={b.tone}>{b.label}</Badge>)
          }
        </span>
      </div>
    </section>

    <!-- Cards -->
    <section id="cards" class="py-14">
      <SectionHeading heading={s.sections.cards} />
      <ul class="mt-8 grid gap-6 md:grid-cols-3" role="list">
        {
          s.cards.map((c) => (
            <li>
              <Card {...c} />
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Stats -->
    <section id="stats" class="py-14">
      <SectionHeading heading={s.sections.stats} />
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="grid gap-8 rounded-lg border border-line p-8 sm:grid-cols-2">
          {s.stats.map((st) => <Stat {...st} />)}
        </div>
        <div class="grid gap-8 rounded-lg bg-navy-900 p-8 sm:grid-cols-2">
          {s.stats.map((st) => <Stat {...st} tone="dark" />)}
        </div>
      </div>
    </section>

    <section id="sections" class="py-14">
      <SectionHeading heading={s.sections.sectionsHeading} />
    </section>
  </div>

  <!-- Full-width section components -->
  <div class="space-y-0">
    <p class="container-site pb-3 font-mono text-[0.75rem] text-steel-500">Hero</p>
    {page.hero && <Hero {...page.hero} />}

    <p class="container-site pt-10 pb-3 font-mono text-[0.75rem] text-steel-500">Hero · with image</p>
    {page.hero && <Hero {...page.hero} image={industrial} imageAlt="" />}

    <p class="container-site pt-10 pb-3 font-mono text-[0.75rem] text-steel-500">StatBand</p>
    {page.statBand && <StatBand {...page.statBand} />}

    <p class="container-site pt-10 pb-3 font-mono text-[0.75rem] text-steel-500">ProjectGrid</p>
    {page.projects && <ProjectGrid {...page.projects} id="projects" />}

    <p class="container-site pt-10 pb-3 font-mono text-[0.75rem] text-steel-500">ProcessSteps</p>
    {page.process && <ProcessSteps {...page.process} id="process" />}

    <p class="container-site pt-10 pb-3 font-mono text-[0.75rem] text-steel-500">FAQ</p>
    {page.faq && <FAQ {...page.faq} id="faq" />}

    <p class="container-site pt-10 pb-3 font-mono text-[0.75rem] text-steel-500">CTA</p>
    {page.cta && <CTA {...page.cta} id="cta" />}

    {
      pd && (
        <>
          <p class="container-site pt-10 pb-3 font-mono text-[0.75rem] text-steel-500">
            Project template components · content from src/content/projects/{project!.id}.yaml
          </p>
          <div class="container-site space-y-6 pb-10">
            <p class="font-mono text-[0.75rem] text-steel-500">Breadcrumbs · FactList · Badge tones navy / brand / neutral / plan / highlight</p>
            <Breadcrumbs items={[{ label: pl.breadcrumbRoot, href: '#' }, { label: 'Industrial' }, { label: pd.name }]} label="Breadcrumb example" />
            <div class="max-w-md rounded-lg border border-line bg-surface-alt p-6">
              <FactList rows={pd.glance.slice(0, 3)} />
            </div>
          </div>
          <p class="container-site pb-3 font-mono text-[0.75rem] text-steel-500">Hero · overlap + KeyFacts</p>
          <Hero
            headline={pd.name}
            eyebrow={`Industrial · ${pd.town}, ${pl.region}`}
            intro={pd.summary}
            image={pd.heroImage}
            imageAlt={pd.heroImageAlt}
            breadcrumbs={[{ label: pl.breadcrumbRoot, href: '#' }, { label: 'Industrial' }, { label: pd.name }]}
            badges={[{ label: pl.projectNowLeasing, tone: 'highlight' }, { label: pd.tags[0] ?? '', tone: 'inverse' }]}
            overlap
          />
          <KeyFacts facts={pd.keyFacts} label={pl.keyFacts} />
          <p class="container-site pt-10 pb-3 font-mono text-[0.75rem] text-steel-500">ProjectOverview</p>
          <ProjectOverview
            id="sg-overview"
            eyebrow={pd.overview.eyebrow}
            heading={pd.overview.heading}
            lead={pd.overview.lead}
            paragraphs={paragraphs(pd.overview.body)}
            glance={{ heading: pl.glanceHeading, rows: pd.glance }}
            link={{ label: pl.brochure, href: '#' }}
          />
          <p class="container-site pt-10 pb-3 font-mono text-[0.75rem] text-steel-500">BuildingAvailability</p>
          <BuildingAvailability
            id="sg-buildings"
            eyebrow={pd.availability.eyebrow}
            heading={pd.availability.heading}
            intro={pd.availability.intro}
            sitePlan={pd.availability.sitePlan ? { image: pd.availability.sitePlan, alt: pd.availability.sitePlanAlt, caption: pd.availability.sitePlanCaption } : undefined}
            buildings={pBuildings}
            featured={pBuildings.find((b) => b.status.tone === 'brand')}
            labels={{
              featuredEyebrow: pl.featuredEyebrow, featuredCta: pl.featuredCta, featuredHref: '#',
              tableCaption: pl.tableCaption, building: pl.columnBuilding, size: pl.columnSize,
              clearHeight: pl.columnClearHeight, docks: pl.columnDocks, configuration: pl.columnConfiguration,
              status: pl.columnStatus, delivery: pl.columnDelivery,
            }}
          />
          <p class="container-site pt-10 pb-3 font-mono text-[0.75rem] text-steel-500">LocationAccess · fallback panel (no map image)</p>
          <LocationAccess
            id="sg-location"
            eyebrow={pd.location.eyebrow}
            heading={pd.location.heading}
            intro={pd.location.intro}
            distances={pd.location.distances}
            place={{ name: pd.name, town: pd.town }}
          />
          <p class="container-site pt-10 pb-3 font-mono text-[0.75rem] text-steel-500">ProcessSteps · variant cards · background blueprint</p>
          <ProcessSteps id="sg-role" eyebrow={pd.process.eyebrow} heading={pd.process.heading} intro={pd.process.intro} steps={pd.process.steps} variant="cards" background="blueprint" />
          <p class="container-site pt-10 pb-3 font-mono text-[0.75rem] text-steel-500">Gallery</p>
          <Gallery id="sg-gallery" eyebrow={pd.gallery.eyebrow} heading={pd.gallery.heading} note={pd.gallery.updated} items={pd.gallery.items} />
        </>
      )
    }
  </div>
</BaseLayout>
