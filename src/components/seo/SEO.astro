---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import defaultOgImage from '../../assets/images/brand/og-default.png';

interface Props {
  /** Full document title (BaseLayout appends the site name). */
  title: string;
  description: string;
  siteName: string;
  /** Social share image. Defaults to the brand OG image. */
  image?: ImageMetadata;
  imageAlt?: string;
  /** Override the canonical URL (defaults to the current path on `site`). */
  canonical?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description,
  siteName,
  image = defaultOgImage,
  imageAlt = siteName,
  canonical: canonicalOverride,
  type = 'website',
  noindex = false,
} = Astro.props;

const canonical = new URL(canonicalOverride ?? Astro.url.pathname, Astro.site).toString();
const og = await getImage({ src: image, width: 1200, format: 'png' });
const ogUrl = new URL(og.src, Astro.site).toString();
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content={String(og.attributes.width ?? image.width)} />
<meta property="og:image:height" content={String(og.attributes.height ?? image.height)} />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
