---
interface Props {
  value: string;
  label: string;
  description?: string;
  /** `light` for white/grey backgrounds, `dark` for navy sections. */
  tone?: 'light' | 'dark';
  class?: string;
}

const { value, label, description, tone = 'light', class: className } = Astro.props;
const dark = tone === 'dark';
---

<div class:list={['border-l-2 pl-5', dark ? 'border-accent-400' : 'border-blue-600', className]}>
  <dl class="flex flex-col-reverse gap-2">
    <dt class:list={['eyebrow', dark ? 'text-navy-100' : 'text-steel-600']}>{label}</dt>
    <dd class:list={['font-display text-stat font-bold', dark ? 'text-white' : 'text-navy-700']}>{value}</dd>
  </dl>
  {description && <p class:list={['mt-3 text-small', dark ? 'text-navy-100' : 'text-muted']}>{description}</p>}
</div>
