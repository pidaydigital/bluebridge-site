---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  body?: string;
  eyebrow?: string;
  /** Makes the whole card a link. */
  href?: string;
  linkLabel?: string;
  image?: ImageMetadata;
  /** Required whenever `image` is set. */
  imageAlt?: string;
  headingLevel?: 'h2' | 'h3' | 'h4';
  class?: string;
}

const {
  title,
  body,
  eyebrow,
  href,
  linkLabel,
  image,
  imageAlt,
  headingLevel: Heading = 'h3',
  class: className,
} = Astro.props;

if (image && !imageAlt) {
  throw new Error(`Card "${title}": imageAlt is required when an image is provided.`);
}
---

<article
  class:list={[
    'group relative flex h-full flex-col overflow-hidden rounded-lg border border-line bg-white shadow-card transition-shadow duration-200',
    href && 'hover:shadow-card-hover focus-within:shadow-card-hover',
    className,
  ]}
>
  {
    image && (
      <div class="aspect-[16/10] overflow-hidden bg-steel-100">
        <Image
          src={image}
          alt={imageAlt!}
          widths={[400, 640, 960]}
          sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        />
      </div>
    )
  }
  <div class="flex flex-1 flex-col gap-3 p-6 sm:p-7">
    {eyebrow && <p class="eyebrow text-blue-600">{eyebrow}</p>}
    <Heading class="text-h4 text-navy-900">
      {
        href ? (
          <a href={href} class="after:absolute after:inset-0 focus-visible:outline-none">
            {title}
          </a>
        ) : (
          title
        )
      }
    </Heading>
    {body && <p class="text-muted">{body}</p>}
    <slot />
    {
      href && linkLabel && (
        <p class="mt-auto pt-2 text-small font-semibold text-blue-600" aria-hidden="true">
          {linkLabel} <span class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
        </p>
      )
    }
  </div>
</article>
