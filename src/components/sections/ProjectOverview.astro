---
import SectionHeading from '../ui/SectionHeading.astro';
import FactList from '../ui/FactList.astro';
import Button from '../ui/Button.astro';

interface Props {
  heading: string;
  eyebrow?: string;
  /** Lead paragraph, in ink. */
  lead?: string;
  /** Further paragraphs, in muted text. */
  paragraphs?: string[];
  /** The "At a glance" panel. Omitted when there are no rows. */
  glance?: { heading: string; rows: { label: string; value: string }[] };
  /** Optional download link under the panel. */
  link?: { label: string; href: string };
  id?: string;
}

const { heading, eyebrow, lead, paragraphs = [], glance, link, id } = Astro.props;
const headingId = id ? `${id}-heading` : undefined;
const glanceId = id ? `${id}-glance` : 'glance-heading';
---

<section id={id} class="section" aria-labelledby={headingId}>
  <div class="container-site grid gap-10 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:gap-20">
    <div class="max-w-3xl">
      <SectionHeading heading={heading} eyebrow={eyebrow} id={headingId} />
      {lead && <p class="mt-6 text-lead text-ink">{lead}</p>}
      {paragraphs.map((p, i) => <p class:list={['text-muted', i === 0 ? 'mt-5' : 'mt-4']}>{p}</p>)}
    </div>
    {
      glance && glance.rows.length > 0 && (
        <aside aria-labelledby={glanceId} class="self-start rounded-lg border border-line bg-surface-alt p-6 sm:p-8">
          <h3 id={glanceId} class="mb-5 text-h4 text-navy-900">
            {glance.heading}
          </h3>
          <FactList rows={glance.rows} />
          {link && (
            <Button href={link.href} variant="ghost" arrow class="mt-6">
              {link.label}
            </Button>
          )}
        </aside>
      )
    }
  </div>
</section>
