---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';

interface Project {
  title: string;
  summary: string;
  image: ImageMetadata;
  imageAlt: string;
  sector?: string;
  location?: string;
  status?: string;
  href?: string;
}

interface Props {
  heading: string;
  items: Project[];
  eyebrow?: string;
  intro?: string;
  id?: string;
  /** Link beside the heading, e.g. "All projects". */
  action?: { label: string; href: string };
  background?: 'alt' | 'white';
  /** Shown instead of the grid when there are no items. */
  empty?: string;
}

const { heading, items, eyebrow, intro, id, action, background = 'alt', empty } = Astro.props;
const headingId = id ? `${id}-heading` : undefined;
---

<section id={id} class:list={['section', background === 'alt' ? 'bg-surface-alt' : 'bg-white']} aria-labelledby={headingId}>
  <div class="container-site">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading heading={heading} eyebrow={eyebrow} intro={intro} id={headingId} />
      {
        action && (
          <Button href={action.href} variant="ghost" arrow>
            {action.label}
          </Button>
        )
      }
    </div>
    {items.length === 0 && empty && <p class="mt-10 text-lead text-muted">{empty}</p>}
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8" role="list">
      {
        items.map((p) => (
          <li>
            <article class="group relative flex h-full flex-col overflow-hidden rounded-lg bg-white shadow-card transition-shadow duration-200 focus-within:shadow-card-hover hover:shadow-card-hover">
              <div class="relative aspect-[4/3] overflow-hidden bg-steel-100">
                <Image
                  src={p.image}
                  alt={p.imageAlt}
                  widths={[400, 640, 960]}
                  sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                />
                {p.status && (
                  <div class="absolute top-4 left-4">
                    <Badge tone="inverse" class="bg-navy-950/70 backdrop-blur-sm">
                      {p.status}
                    </Badge>
                  </div>
                )}
              </div>
              <div class="flex flex-1 flex-col p-6">
                {p.sector && <p class="eyebrow text-blue-600">{p.sector}</p>}
                <h3 class="mt-2 text-h4 text-navy-900">
                  {p.href ? (
                    <a href={p.href} class="after:absolute after:inset-0 focus-visible:outline-none">
                      {p.title}
                    </a>
                  ) : (
                    p.title
                  )}
                </h3>
                <p class="mt-3 text-muted">{p.summary}</p>
                {p.location && (
                  <p class="mt-auto flex items-center gap-2 pt-5 text-small text-steel-600">
                    <svg aria-hidden="true" class="h-4 w-4 shrink-0 text-steel-400" viewBox="0 0 20 20" fill="currentColor">
                      <path
                        fill-rule="evenodd"
                        d="M10 18s6-5.3 6-10A6 6 0 1 0 4 8c0 4.7 6 10 6 10Zm0-7.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"
                        clip-rule="evenodd"
                      />
                    </svg>
                    {p.location}
                  </p>
                )}
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>
