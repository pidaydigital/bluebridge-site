---
import SectionHeading from '../ui/SectionHeading.astro';
import Schema from '../seo/Schema.astro';

interface Props {
  heading: string;
  items: { question: string; answer: string }[];
  eyebrow?: string;
  intro?: string;
  id?: string;
  /** Emit FAQPage JSON-LD. Only enable on the canonical page for these questions. */
  withSchema?: boolean;
}

const { heading, items, eyebrow, intro, id, withSchema = false } = Astro.props;
const headingId = id ? `${id}-heading` : undefined;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<section id={id} class="section bg-surface-alt" aria-labelledby={headingId}>
  <div class="container-site grid gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-16">
    <SectionHeading heading={heading} eyebrow={eyebrow} intro={intro} id={headingId} />
    <div class="divide-y divide-line border-y border-line">
      {
        items.map((item) => (
          <details class="group py-1 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 font-display text-h4 font-bold text-navy-900 hover:text-blue-600">
              <span>{item.question}</span>
              <span
                aria-hidden="true"
                class="relative mt-1.5 h-4 w-4 shrink-0 before:absolute before:top-1/2 before:left-0 before:h-0.5 before:w-4 before:-translate-y-1/2 before:bg-current after:absolute after:top-0 after:left-1/2 after:h-4 after:w-0.5 after:-translate-x-1/2 after:bg-current after:transition-transform group-open:after:scale-y-0"
              />
            </summary>
            <p class="pb-6 text-muted">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
  {withSchema && <Schema data={faqSchema} />}
</section>
