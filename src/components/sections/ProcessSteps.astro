---
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  heading: string;
  steps: { title: string; body: string }[];
  eyebrow?: string;
  intro?: string;
  id?: string;
}

const { heading, steps, eyebrow, intro, id } = Astro.props;
const headingId = id ? `${id}-heading` : undefined;
---

<section id={id} class="section bg-white" aria-labelledby={headingId}>
  <div class="container-site">
    <SectionHeading heading={heading} eyebrow={eyebrow} intro={intro} id={headingId} />
    <ol class="mt-12 grid gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8" role="list">
      {
        steps.map((step, i) => (
          <li class="relative border-t-2 border-navy-700 pt-6">
            <span class="font-display text-h3 font-bold text-blue-600" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-3 text-h4 text-navy-900">
              <span class="sr-only">Step {i + 1}: </span>
              {step.title}
            </h3>
            <p class="mt-3 text-muted">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
