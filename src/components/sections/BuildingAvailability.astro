---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Badge from '../ui/Badge.astro';
import Stat from '../ui/Stat.astro';
import Button from '../ui/Button.astro';

type Tone = 'neutral' | 'brand' | 'accent' | 'outline' | 'inverse' | 'navy' | 'plan' | 'highlight';

interface Building {
  name: string;
  size: string;
  clearHeight: string;
  docks: string;
  configuration: string;
  status: { label: string; tone: Tone };
  summary?: string;
  delivery?: string;
}

interface Props {
  heading: string;
  eyebrow?: string;
  intro?: string;
  id?: string;
  /** Uploaded site plan; the figure is left out when there is none. */
  sitePlan?: { image: ImageMetadata; alt: string; caption?: string };
  buildings: Building[];
  /** The building shown in the dark card beside the site plan. */
  featured?: Building;
  labels: {
    featuredEyebrow: string;
    featuredCta: string;
    featuredHref: string;
    tableCaption: string;
    building: string;
    size: string;
    clearHeight: string;
    docks: string;
    configuration: string;
    status: string;
    delivery: string;
  };
}

const { heading, eyebrow, intro, id, sitePlan, buildings, featured, labels } = Astro.props;
const headingId = id ? `${id}-heading` : undefined;
const cols = ['size', 'clearHeight', 'docks', 'configuration'] as const;
const featuredStats = featured
  ? [
      { label: labels.size, value: featured.size },
      { label: labels.clearHeight, value: featured.clearHeight },
      { label: labels.docks, value: featured.docks },
      { label: labels.delivery, value: featured.delivery ?? '' },
    ].filter((s) => s.value)
  : [];
---

<section id={id} class="section border-y border-line bg-surface-alt" aria-labelledby={headingId}>
  <div class="container-site">
    <SectionHeading heading={heading} eyebrow={eyebrow} intro={intro} id={headingId} />

    {
      (sitePlan || featured) && (
        <div class="mt-12 grid gap-8 lg:grid-cols-[minmax(0,1fr)_24rem] xl:grid-cols-[minmax(0,1fr)_26rem]">
          {sitePlan && (
            <figure class="rounded-lg border border-line bg-white p-4 shadow-card sm:p-6">
              <Image
                src={sitePlan.image}
                alt={sitePlan.alt}
                widths={[640, 960, 1280, 1600]}
                sizes="(min-width: 1280px) 52rem, (min-width: 1024px) 70vw, 100vw"
                class="w-full rounded-md"
              />
              {sitePlan.caption && <figcaption class="mt-4 text-small text-muted">{sitePlan.caption}</figcaption>}
            </figure>
          )}
          {featured && (
            <article class="relative isolate flex flex-col overflow-hidden rounded-lg bg-navy-900 p-7 text-navy-100 sm:p-8">
              <div
                aria-hidden="true"
                class="absolute -top-24 -right-24 -z-10 h-72 w-72 rounded-full border-[40px] border-navy-700/60"
              />
              <p class="eyebrow mb-3 text-accent-400">{labels.featuredEyebrow}</p>
              <h3 class="text-h3 text-white">{featured.name}</h3>
              {featured.summary && <p class="mt-3">{featured.summary}</p>}
              {featuredStats.length > 0 && (
                <div class="mt-6 grid grid-cols-2 gap-5">
                  {featuredStats.map((s) => (
                    <Stat value={s.value} label={s.label} tone="dark" size="sm" />
                  ))}
                </div>
              )}
              <div class="grow" />
              <Button href={labels.featuredHref} variant="inverse" arrow class="mt-8">
                {labels.featuredCta}
              </Button>
            </article>
          )}
        </div>
      )
    }

    {
      buildings.length > 0 && (
        <div class="mt-8 overflow-x-auto rounded-lg border border-line bg-white">
          <table class="w-full min-w-[47.5rem] border-collapse text-left text-[0.9375rem]">
            <caption class="px-6 pt-5 text-left font-display text-h4 font-bold text-navy-900">{labels.tableCaption}</caption>
            <thead>
              <tr>
                {[labels.building, labels.size, labels.clearHeight, labels.docks, labels.configuration, labels.status].map(
                  (h) => (
                    <th scope="col" class="eyebrow border-b border-line px-6 py-4 text-[0.75rem] text-steel-600">
                      {h}
                    </th>
                  ),
                )}
              </tr>
            </thead>
            <tbody>
              {buildings.map((b, i) => {
                const last = i === buildings.length - 1;
                return (
                  <tr>
                    <th scope="row" class:list={['px-6 py-4 font-semibold', !last && 'border-b border-steel-100']}>
                      {b.name}
                    </th>
                    {cols.map((c) => (
                      <td class:list={['px-6 py-4', !last && 'border-b border-steel-100']}>{b[c]}</td>
                    ))}
                    <td class:list={['px-6 py-4', !last && 'border-b border-steel-100']}>
                      <Badge tone={b.status.tone}>{b.status.label}</Badge>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )
    }
  </div>
</section>
