---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  heading: string;
  eyebrow?: string;
  /** Small note at the right of the heading, e.g. "Updated March 2027". */
  note?: string;
  /** First item is shown full width (21:9); the rest at 4:3. */
  items: { image: ImageMetadata; alt: string; caption?: string }[];
  id?: string;
}

const { heading, eyebrow, note, items, id } = Astro.props;
const headingId = id ? `${id}-heading` : undefined;
---

<section id={id} class="section" aria-labelledby={headingId}>
  <div class="container-site">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading heading={heading} eyebrow={eyebrow} id={headingId} />
      {note && <p class="text-small text-steel-500">{note}</p>}
    </div>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map((item, i) => (
          <figure class:list={[i === 0 && 'sm:col-span-2 lg:col-span-3']}>
            <Image
              src={item.image}
              alt={item.alt}
              widths={i === 0 ? [640, 1024, 1600, 2100] : [400, 640, 960]}
              sizes={i === 0 ? '(min-width: 1280px) 75rem, 100vw' : '(min-width: 1024px) 25rem, (min-width: 640px) 50vw, 100vw'}
              class:list={['w-full rounded-lg bg-steel-100 object-cover', i === 0 ? 'aspect-[21/9]' : 'aspect-[4/3]']}
            />
            {item.caption && <figcaption class="mt-3 text-small text-muted">{item.caption}</figcaption>}
          </figure>
        ))
      }
    </div>
  </div>
</section>
