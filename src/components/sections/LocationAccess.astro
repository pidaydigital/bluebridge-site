---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';

interface Props {
  heading: string;
  eyebrow?: string;
  intro?: string;
  id?: string;
  /** e.g. { value: "4 mi", label: "to Interstate 85" } */
  distances: { value: string; label: string }[];
  /** Static map image. Without one, a simple location panel is shown. */
  map?: { image: ImageMetadata; alt: string };
  /** Name and place shown on the fallback panel's pin. */
  place: { name: string; town: string };
  mapLink?: { label: string; href: string };
}

const { heading, eyebrow, intro, id, distances, map, place, mapLink } = Astro.props;
const headingId = id ? `${id}-heading` : undefined;
---

<section id={id} class="section" aria-labelledby={headingId}>
  <div class="container-site grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
    <div>
      <SectionHeading heading={heading} eyebrow={eyebrow} intro={intro} id={headingId} />
      {
        distances.length > 0 && (
          <ul class="mt-8 grid grid-cols-2 gap-6" role="list">
            {distances.map((d) => (
              <li class="border-l-2 border-blue-600 pl-4">
                <span class="block font-display text-h3 font-bold text-navy-700">{d.value}</span>
                <span class="mt-1 block text-small text-muted">{d.label}</span>
              </li>
            ))}
          </ul>
        )
      }
      {
        mapLink && (
          <Button href={mapLink.href} variant="ghost" arrow class="mt-8" target="_blank" rel="noopener">
            {mapLink.label}
          </Button>
        )
      }
    </div>
    {
      map ? (
        <Image
          src={map.image}
          alt={map.alt}
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 1024px) 40rem, 100vw"
          class="aspect-[4/3] w-full rounded-lg border border-line object-cover"
        />
      ) : (
        <div class="relative aspect-[4/3] overflow-hidden rounded-lg border border-line bg-navy-50">
          <svg aria-hidden="true" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" fill="none" class="absolute inset-0 h-full w-full">
            <path d="M-10 230 C 90 200, 160 150, 240 120 S 380 60, 420 40" class="stroke-navy-200" stroke-width="10" stroke-linecap="round" />
            <path d="M-10 230 C 90 200, 160 150, 240 120 S 380 60, 420 40" class="stroke-white" stroke-width="2" stroke-dasharray="8 8" />
            <path d="M150 -10 C 160 80, 190 180, 170 310" class="stroke-navy-100" stroke-width="6" />
            <path d="M30 60 H120 M60 20 V120 M280 200 H380 M320 160 V280" class="stroke-navy-100" stroke-width="3" />
          </svg>
          <div class="absolute top-[30%] left-[56%] flex -translate-x-1/2 -translate-y-full flex-col items-center gap-1.5">
            <span class="rounded-md bg-navy-900 px-2.5 py-1.5 text-[0.8125rem] font-semibold whitespace-nowrap text-white">
              {place.name}
            </span>
            <svg aria-hidden="true" class="h-7 w-7 fill-blue-600 stroke-white" viewBox="0 0 24 24" stroke-width="1.5">
              <path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z" />
              <circle cx="12" cy="10" r="2.5" class="fill-white" stroke="none" />
            </svg>
          </div>
          <p class="sr-only">{place.name}, {place.town}</p>
        </div>
      )
    }
  </div>
</section>
