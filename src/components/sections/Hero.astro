---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';

interface Link {
  label: string;
  href: string;
}

interface Props {
  headline: string;
  eyebrow?: string;
  intro?: string;
  primary?: Link;
  secondary?: Link;
  /** Optional background image; rendered under a navy overlay. */
  image?: ImageMetadata;
  imageAlt?: string;
  /** Trail shown above the badges, last item = current page. */
  breadcrumbs?: { label: string; href?: string }[];
  /** Small labels above the eyebrow, e.g. project status. */
  badges?: { label: string; tone: 'highlight' | 'inverse' }[];
  /** Extra bottom padding so a card (KeyFacts) can overlap the bottom edge. */
  overlap?: boolean;
}

const { headline, eyebrow, intro, primary, secondary, image, imageAlt, breadcrumbs, badges, overlap = false } = Astro.props;

if (image && imageAlt === undefined) {
  throw new Error('Hero: imageAlt is required when an image is provided (use "" for decorative images).');
}
---

<section class="relative isolate overflow-hidden bg-navy-900 text-white">
  {
    image ? (
      <>
        <Image
          src={image}
          alt={imageAlt!}
          widths={[640, 1024, 1600, 2000]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 -z-20 h-full w-full object-cover"
        />
        <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950/90 via-navy-900/75 to-navy-900/40" />
      </>
    ) : (
      <div
        aria-hidden="true"
        class="absolute inset-0 -z-10 bg-[linear-gradient(135deg,var(--color-navy-950)_0%,var(--color-navy-900)_55%,var(--color-navy-700)_100%)]"
      >
        <svg class="absolute right-0 bottom-0 h-full w-auto max-w-none opacity-[0.12]" viewBox="0 0 800 600" fill="none">
          <path d="M0 520 C 200 300, 600 300, 800 520" stroke="white" stroke-width="2" />
          <path d="M0 560 C 200 360, 600 360, 800 560" stroke="white" stroke-width="1" />
          {Array.from({ length: 15 }, (_, i) => {
            const x = 50 + i * 50;
            const t = x / 800;
            const y = 520 - 4 * t * (1 - t) * 165;
            return <line x1={x} y1={y} x2={x} y2="600" stroke="white" stroke-width="1" />;
          })}
          <line x1="0" y1="600" x2="800" y2="600" stroke="white" stroke-width="2" />
        </svg>
      </div>
    )
  }

  <div class:list={['container-site', overlap ? 'pt-12 pb-24 sm:pt-16 sm:pb-28 lg:pt-20 lg:pb-32' : 'py-20 sm:py-28 lg:py-36']}>
    {breadcrumbs && breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} tone="dark" class="mb-10" />}
    <div class="max-w-3xl">
      {
        badges && badges.length > 0 && (
          <ul class="mb-5 flex flex-wrap gap-2" role="list">
            {badges.map((b) => (
              <li>
                <Badge tone={b.tone}>{b.label}</Badge>
              </li>
            ))}
          </ul>
        )
      }
      {eyebrow && <p class="eyebrow mb-5 text-accent-400">{eyebrow}</p>}
      <h1 class="text-display text-white">{headline}</h1>
      {intro && <p class="mt-6 max-w-2xl text-lead text-navy-100">{intro}</p>}
      {
        (primary || secondary) && (
          <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            {primary && (
              <Button href={primary.href} variant="inverse" size="lg" arrow>
                {primary.label}
              </Button>
            )}
            {secondary && (
              <Button href={secondary.href} variant="outline-inverse" size="lg">
                {secondary.label}
              </Button>
            )}
          </div>
        )
      }
    </div>
  </div>
</section>
